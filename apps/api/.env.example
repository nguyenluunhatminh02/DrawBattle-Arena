DATABASE_URL=postgresql://drawbattle:drawbattle@localhost:5440/drawbattle
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-random-64-char-hex-string
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
THROTTLE_MULT=1
# Trusted reverse-proxy hop count. Leave unset (safe default: 0) unless the API
# runs behind a known proxy/tunnel; then set it to the exact hop count, e.g. 1.
# docker-compose.yml overrides this with ${TRUST_PROXY:-0}.
TRUST_PROXY=0
