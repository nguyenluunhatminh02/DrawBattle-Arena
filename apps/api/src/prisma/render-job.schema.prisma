enum RenderJobState {
  queued
  running
  completed
  failed
}

/// Optional durable render queue. Migration is intentionally NOT included here:
/// deploy the SQL described in the REPLAY notes before enabling multi-instance workers.
model RenderJob {
  id           String          @id @default(cuid())
  replayId     String          @unique @map("replay_id")
  state        RenderJobState  @default(queued)
  attempts     Int             @default(0)
  maxAttempts  Int             @default(3) @map("max_attempts")
  error        String?
  lockedBy     String?         @map("locked_by")
  lockedAt     DateTime?       @map("locked_at")
  nextAttemptAt DateTime       @default(now()) @map("next_attempt_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  replay Replay @relation(fields: [replayId], references: [id])

  @@index([state, nextAttemptAt])
  @@map("render_jobs")
}
